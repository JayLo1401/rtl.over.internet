# Umgebung für das Arcane-Projekt „rtl-over-internet“ (deploy/docker-compose.arcane.yml).
# Werte erzeugen z. B. mit:  openssl rand -base64 24   bzw.   openssl rand -base64 48

# Image-Version (feste Version empfohlen, z. B. 0.2.0; latest = immer die neueste)
ROI_TAG=0.2.0

# Admin der Weboberfläche (Systemadmin). Das Passwort gilt auch beim Enrollment an jeder Instanz.
ROI_ADMIN_USER=admin
ROI_ADMIN_PASSWORD=

# Schlüssel für CSRF und die Verschlüsselung der Instanz-Passwörter. Einmal setzen und NIE ändern,
# sonst sind gespeicherte Instanz-Passwörter nicht mehr abrufbar.
ROI_SECRET_KEY=

# Optional: Anmeldung über authentik (Redirect-URI https://rtl.jaycloud.at/login/oidc/callback)
ROI_AUTH_MODES=all
ROI_OIDC_ISSUER=
ROI_OIDC_CLIENT_ID=
ROI_OIDC_CLIENT_SECRET=
ROI_OIDC_ADMIN_GROUPS=
ROI_OIDC_USER_GROUPS=
