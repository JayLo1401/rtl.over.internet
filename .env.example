# Beispielkonfiguration für rtl.over.internet.
# Kopieren nach .env (wird nicht committet) und anpassen:   cp .env.example .env
# docker compose liest .env automatisch (docker-compose.yml und docker-compose.local.yml).
# Beschreibung aller Variablen: README.md, Abschnitt „Konfiguration“.

# --- Pflicht -----------------------------------------------------------------

# Öffentliche Adresse. Bei https:// wird das Sitzungs-Cookie automatisch "Secure".
# Lokaler Test: http://<LAN-IP>:8090
ROI_PUBLIC_URL=https://rtl.jaycloud.at

# Admin der Weboberfläche. Passwort mind. 12 Zeichen, z. B. erzeugen mit: openssl rand -base64 24
# Gespeichert wird nur der Hash; bei jedem Start wird das Passwort aus dieser Variable übernommen.
ROI_ADMIN_USER=admin
ROI_ADMIN_PASSWORD=
# (bei ROI_AUTH_MODES=oidc nicht nötig)
# Alternativ statt ROI_ADMIN_PASSWORD eine Datei (z. B. Docker-Secret):
# ROI_ADMIN_PASSWORD_FILE=/run/secrets/roi_admin_password

# --- Netzwerk ----------------------------------------------------------------

# Weboberfläche + Steuerkanal. Hinter nginx mit network_mode: host nur lokal binden.
ROI_HTTP_HOST=127.0.0.1
ROI_HTTP_PORT=8090

# Nur von diesen Adressen wird X-Forwarded-For übernommen (nginx auf demselben Host).
ROI_TRUSTED_PROXIES=127.0.0.1/32,::1/128

# Rendezvous (UDP, nicht über nginx). "::" = IPv4 und IPv6.
ROI_RENDEZVOUS_BIND=::
ROI_RENDEZVOUS_PORTS=3478,3479
# Hostname, den die rtltcp.server für das Rendezvous nutzen (Standard: Host aus ROI_PUBLIC_URL)
# ROI_RENDEZVOUS_HOST=rtl.jaycloud.at

# --- Anmeldung über OpenID Connect (authentik), optional ---------------------
#
# all      = Admin-Passwort und OIDC (Standard; OIDC nur, wenn unten konfiguriert)
# internal = nur Admin-Passwort (OIDC-Werte werden ignoriert)
# oidc     = nur OIDC; ROI_ADMIN_PASSWORD wird dann nicht gebraucht und gilt auch nicht beim Enrollment
ROI_AUTH_MODES=all
#
# In authentik einen "OAuth2/OpenID Provider" (confidential) anlegen,
# Redirect-URI: <ROI_PUBLIC_URL>/login/oidc/callback  (z. B. https://rtl.jaycloud.at/login/oidc/callback)
# ROI_OIDC_ISSUER = "OpenID Configuration Issuer" aus authentik, z. B.
#   https://auth.jaycloud.at/application/o/rtl-over-internet/
# Leer lassen = kein OIDC-Button.
ROI_OIDC_ISSUER=
ROI_OIDC_CLIENT_ID=
ROI_OIDC_CLIENT_SECRET=
ROI_OIDC_BUTTON_LABEL=Mit authentik anmelden
# Rollen aus dem Claim "groups" (authentik: Scope profile), kommagetrennt. Wer in keiner Gruppe ist, kommt nicht hinein.
#   ADMIN_GROUPS = Systemadmin (alle Instanzen, Benutzer verwalten, Audit-Log)
#   USER_GROUPS  = darf sich anmelden, hat aber keine Rechte, bis ihm Instanzen zugewiesen werden
#                  (als Instanz-Admin oder Benutzer, in der Weboberfläche auf der Seite der Instanz)
# Die Rolle wird bei jeder Anmeldung neu aus den Gruppen übernommen.
ROI_OIDC_ADMIN_GROUPS=
ROI_OIDC_USER_GROUPS=

# --- Optional ----------------------------------------------------------------

# Schlüssel für CSRF-Tokens und die Verschlüsselung der Instanz-Passwörter (mind. 32 Zeichen).
# Fehlt er, wird er einmalig in /data/secret_key erzeugt. Ändert er sich, sind gespeicherte
# Instanz-Passwörter nicht mehr abrufbar (dann „Neues Passwort“ erzeugen).
# ROI_SECRET_KEY=

# Secure-Cookie erzwingen bzw. abschalten (Standard: an bei https://-URL)
# ROI_COOKIE_SECURE=true

# Zeitzone der Anzeige
ROI_TIMEZONE=Europe/Vienna

# Image-Version für docker-compose.yml (Standard latest)
# ROI_TAG=0.1.0

# Datenverzeichnis auf dem Host (SQLite, secret_key). Muss UID 10001 gehören.
# Standard ./data neben der Compose-Datei. Für Arcane gibt es deploy/docker-compose.arcane.yml (/srv/...).
# ROI_DATA_PATH=/srv/rtl.over.internet/data
