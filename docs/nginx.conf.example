# nginx vor rtl.over.internet (Beispiel)
#
# Platzhalter: mediator.example.com → eigener Hostname, 8090 → ROI_HTTP_PORT.
# Ablage z. B. /etc/nginx/sites-available/<hostname>, verlinkt nach sites-enabled (bzw. conf.d/<hostname>.conf).
#
# Die Datei enthält zunächst nur HTTP. Das Zertifikat und die Umleitung auf HTTPS ergänzt danach certbot:
#   nginx -t && systemctl reload nginx
#   certbot --nginx -d mediator.example.com
#
# Nur Weboberfläche, Enrollment und Steuerkanal laufen über nginx. Der Rendezvous-Endpunkt
# (UDP 3478/3479) geht NICHT über nginx, sondern direkt an den Container (network_mode: host).

server {
    listen 80;
    listen [::]:80;
    server_name mediator.example.com;
    server_tokens off;

    # Die App braucht nur kleine Anfragen (Formulare, Enrollment)
    client_max_body_size 64k;

    # Steuerkanal der rtltcp.server: nur WebSocket, dauerhaft offen.
    # Kein map-Block nötig: an diesem Pfad gibt es ausschließlich Upgrade-Anfragen.
    location = /api/v1/control {
        proxy_pass http://127.0.0.1:8090;
        proxy_http_version 1.1;
        proxy_set_header Upgrade           $http_upgrade;
        proxy_set_header Connection        "upgrade";
        proxy_set_header Host              $host;
        # überschreiben, nicht anhängen: Clients können ihre Adresse so nicht fälschen
        proxy_set_header X-Forwarded-For   $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 1h;
        proxy_send_timeout 1h;
        proxy_buffering off;
    }

    # Weboberfläche und Enrollment
    location / {
        proxy_pass http://127.0.0.1:8090;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Forwarded-For   $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 30s;
    }
}
